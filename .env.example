# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# Every value below is a PLACEHOLDER, not a real secret.

# development | test | production
NODE_ENV=development

# Render sets PORT automatically. Locally, 3000 is fine.
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# MongoDB Atlas connection string (database USER password, not Atlas account password).
# Example shape only:
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/checkmate?retryWrites=true&w=majority
MONGODB_MAX_POOL_SIZE=10

# Comma-separated list of allowed browser origins. Leave empty if only the
# Android app calls the API (the app does not send an Origin header).
CORS_ORIGINS=

# WebSocket limits
WS_MAX_PAYLOAD_BYTES=16384
WS_HEARTBEAT_INTERVAL_MS=30000

# Required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=<generate-a-64-hex-character-secret>
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Optional WebSocket tuning
WS_AUTH_TIMEOUT_MS=10000
WS_REAUTH_GRACE_MS=30000
WS_TOKEN_WARNING_MS=30000

# Optional spectators and saved analysis (D-042, D-044). Defaults shown.
SPECTATOR_MAX_PER_GAME=20
ANALYSIS_SESSIONS_MAX=50

# Optional storage watch (D-028). Atlas M0 = 512 MB. A warning is logged at 80%, an error at 90%.
# Check every hour (3600000 ms). Shown at /health/storage.
STORAGE_LIMIT_MB=512

# Voice (WebRTC). STUN is free and always on. TURN is OPTIONAL: leave TURN_URLS empty to run STUN-only.
# Option A, fixed credentials from a provider such as Metered (put the real values only in .env / Render, never here):
#   TURN_URLS=turn:YOUR_TURN_HOST:80,turn:YOUR_TURN_HOST:443?transport=tcp
#   TURN_USERNAME=your-turn-username
#   TURN_CREDENTIAL=your-turn-password
# Option B, time-limited credentials from your own coturn (min 16 characters):
#   TURN_SECRET=generate-a-long-random-value
#   TURN_CREDENTIAL_TTL_SECONDS=3600
ICE_STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
# An unanswered voice call is cancelled after this long (milliseconds).
VOICE_RING_TIMEOUT_MS=45000
STORAGE_CHECK_INTERVAL_MS=3600000

# Analysis rooms (D-035 to D-040). All optional; these are the defaults. The member limit (10) is fixed in code.
# Most moves/variations one room can hold.
ROOM_MAX_NODES=300
# Most open rooms one user can host.
ROOM_MAX_HOSTED=3
# A room nobody is in and nobody touched for this long is closed (milliseconds, 24 h).
ROOM_IDLE_CLOSE_MS=86400000
# Closed rooms are deleted after this many days.
ROOM_RETENTION_DAYS=7
# How often the idle-room check runs (milliseconds).
ROOM_SWEEP_INTERVAL_MS=60000

# Economy and purchases (D-046 to D-050). All optional; these are the defaults.
# Coins given once per UTC day to each player who claims it (0 switches the daily reward off).
DAILY_REWARD_COINS=20
# How often unfinished coin and purchase records are completed after a crash (milliseconds).
WALLET_RECONCILE_INTERVAL_MS=30000
# A coin record is only completed by the clean-up after it is this old (milliseconds).
WALLET_PENDING_AGE_MS=60000
# Who confirms real-money purchases: disabled (default: purchases answer PURCHASES_NOT_CONFIGURED),
# fake (development only, the server REFUSES to start with it in production) or google.
PURCHASE_VERIFIER=disabled
# Only for PURCHASE_VERIFIER=google (needs a Google Play Console account and a service account):
# GOOGLE_PLAY_PACKAGE_NAME=com.example.yourapp
# The key file of the service account as ONE line of JSON. This is a SECRET: put it in the Render dashboard, never in git.
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Tournaments (D-052 to D-055). All optional; these are the defaults.
# A player who is not online and free this long after a round started loses the pairing (milliseconds).
TOURNAMENT_SHOW_UP_MS=180000
# Pause between the last result of a round and the start of the next round (milliseconds).
TOURNAMENT_ROUND_BREAK_MS=30000
# A tournament must start at least this long after it is created (milliseconds) ...
TOURNAMENT_MIN_LEAD_MS=60000
# ... and at most this many days after.
TOURNAMENT_MAX_LEAD_DAYS=7
# Open tournaments (registration or running) one user may host at the same time.
TOURNAMENT_MAX_HOSTED=1

# Retention and cleanup of old data (D-060). All optional; these are the defaults.
# The server runs a background job that removes the move list of finished games older than
# RETENTION_GAME_MOVES_DAYS (the PGN stays) and deletes resolved reports older than RETENTION_REPORTS_DAYS.
# It never runs in tests. See SERVER_SETUP_GUIDE.md before changing anything here.
# Switch the job off completely (true or false).
RETENTION_ENABLED=true
# true = the job only counts and logs what it WOULD do, it changes nothing.
RETENTION_DRY_RUN=false
# How often the job runs (milliseconds, 6 hours) and how long after server start the first run happens (60 s).
RETENTION_INTERVAL_MS=21600000
RETENTION_FIRST_RUN_MS=60000
# Days after which a finished game loses its move list (minimum 7).
RETENTION_GAME_MOVES_DAYS=90
# Days after which a reviewed or dismissed report is deleted (minimum 30). Open reports are never deleted.
RETENTION_REPORTS_DAYS=365
# Documents changed per step (1-1000).
RETENTION_BATCH_SIZE=200

# Live games and matchmaking (D-012, D-013, D-023). All optional; these are the defaults.
# How long a player who lost the connection has to come back before the game is settled (milliseconds, 60 s).
GAME_RECONNECT_GRACE_MS=60000
# How long a paused game (both players gone, or after a server restart) waits before it is settled (milliseconds, 5 min).
GAME_PAUSED_HOLD_MS=300000
# How often the running clocks are written to the database (milliseconds, 5 s).
GAME_CHECKPOINT_INTERVAL_MS=5000
# How long a friend invitation to play stays valid (milliseconds, 60 s).
INVITE_TTL_MS=60000
# How often the matchmaking queue is checked (milliseconds, 2 s).
MATCH_TICK_MS=2000